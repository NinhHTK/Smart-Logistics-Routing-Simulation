def get_distance_km(origin, destination):
    if origin == destination:
        return 0.0
    # Kiểm tra chiều đi từ origin -> destination
    if origin in DISTANCE_MATRIX and destination in DISTANCE_MATRIX[origin]:
        return DISTANCE_MATRIX[origin][destination]
    # Kiểm tra chiều ngược lại destination -> origin (vì khoảng cách 2 chiều như nhau)
    if destination in DISTANCE_MATRIX and origin in DISTANCE_MATRIX[destination]:
        return DISTANCE_MATRIX[destination][origin]
    return 10.0 # Giá trị dự phòng an toàn